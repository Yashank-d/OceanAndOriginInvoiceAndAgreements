# ── Parva Document Generator ───────────────────────────────────
# Copy to `.env` and fill in. App runs on localStorage when empty,
# and uses Turso (libSQL) as the cloud store when both are set.

# Example: libsql://parva-docs-yourorg.turso.io
VITE_TURSO_DATABASE_URL=

# Turso auth token (get via `turso db tokens create <db-name>`)
VITE_TURSO_AUTH_TOKEN=

# ── Turso schema (auto-created on first connect) ──────────────
# CREATE TABLE IF NOT EXISTS documents (
#   id TEXT PRIMARY KEY,
#   document_type TEXT NOT NULL,
#   title TEXT NOT NULL,
#   client_name TEXT NOT NULL,
#   booking_id TEXT NOT NULL,
#   date TEXT NOT NULL,
#   status TEXT NOT NULL,
#   created_at TEXT NOT NULL,
#   updated_at TEXT NOT NULL,
#   data_json TEXT NOT NULL
# );
# CREATE INDEX IF NOT EXISTS idx_documents_booking ON documents(booking_id);
# CREATE INDEX IF NOT EXISTS idx_documents_updated ON documents(updated_at DESC);
